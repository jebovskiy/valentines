# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Railway / App
PORT=3000
NODE_ENV=development
APP_URL=https://your-railway-app.up.railway.app

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token

# FCM (Firebase Cloud Messaging)
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Webhook security (shared secret for pg_net -> Railway)
WEBHOOK_SHARED_SECRET=your-random-32-char-secret

# Pairing token TTL (minutes)
PAIRING_TOKEN_TTL_MINUTES=10

# Integrations
# Google Maps / Places API — powers «Куда пойти» (date spot picker)
GOOGLE_MAPS_API_KEY=your-google-places-api-key

# Gemini — powers AI menu generation (and game rounds / movie insights)
GEMINI_API_KEY=your-gemini-api-key
# Models with a large output cap (>=16384 tokens) are required for the AI
# week menu. Defaults to gemini-2.5-flash; 1.5-flash caps output at 8192 and
# would make every AI menu request fail.
GEMINI_MODEL=gemini-2.5-flash