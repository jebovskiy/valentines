# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Railway / App
PORT=3000
NODE_ENV=development
APP_URL=https://your-railway-app.up.railway.app

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token

# FCM (Firebase Cloud Messaging)
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Webhook security (shared secret for pg_net -> Railway)
WEBHOOK_SHARED_SECRET=your-random-32-char-secret

# Pairing token TTL (minutes)
PAIRING_TOKEN_TTL_MINUTES=10

# Integrations
# Google Maps / Places API — powers «Куда пойти» (date spot picker)
GOOGLE_MAPS_API_KEY=your-google-places-api-key

# Gemini — powers AI menu generation (and game rounds / movie insights)
GEMINI_API_KEY=your-gemini-api-key
# Models with a large output cap (>=16384 tokens) are required for the AI
# week menu. Defaults to gemini-3.5-flash-lite.
# IMPORTANT (2026): 2.5-flash / 1.5-flash are no longer served to new users
# (HTTP 404), and unrestricted API keys are rejected since 2026-06-19 — create
# a NEW restricted key in AI Studio (restricted to the Gemini API).
GEMINI_MODEL=gemini-3.5-flash-lite

# AI provider switch (affects ALL AI features: menu, game rounds, movie
# insights/classification). Options: gemini (default) | deepseek | groq |
# openrouter. Keep GEMINI_API_KEY set to use Gemini as a fallback when the
# primary provider fails (otherwise errors fall through to existing heuristics).
AI_PROVIDER=gemini

# OpenRouter — OpenAI-compatible endpoint. deepseek/deepseek-v4.1-flash
# (DeepSeek V4.1 Flash, $0.15/$0.60 per 1M) is the default; change the slug
# to use any other OpenRouter model. Supports response_format json_object;
# reasoning is disabled per call (reasoning: {enabled:false}) because thinking
# mode eats the 16K token budget and blows the 90s timeout on menu calls.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# DeepSeek — OpenAI-compatible endpoint, deepseek-v4-flash ~ $0.14/$0.28 per 1M
# tokens (cache miss / output). Legacy ids (deepseek-chat) retired 2026-07-24.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Groq — free tier, no card (limited RPM/TPM; a 16K-token menu output consumes
# the whole per-minute budget, so expect pauses between calls).
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile